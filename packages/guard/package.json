{
  "name": "@dsmith-dev/guard",
  "version": "0.2.0",
  "description": "dsmith guard: design-system drift checks for pull requests and ESLint setup",
  "keywords": ["design-system", "dsmith", "guard", "ci", "eslint"],
  "license": "MIT",
  "author": "Dahee Hwang <dahee@project-hh.com>",
  "homepage": "https://github.com/project-hh-org/dsmith#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/project-hh-org/dsmith.git",
    "directory": "packages/guard"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@dsmith-dev/core": "workspace:*",
    "@dsmith-dev/detect": "workspace:*",
    "@dsmith-dev/extractor-api": "workspace:*",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@dsmith-dev/extractor-css": "workspace:*",
    "@dsmith-dev/extractor-emotion": "workspace:*",
    "@dsmith-dev/extractor-inline-style": "workspace:*",
    "@dsmith-dev/extractor-mui-sx": "workspace:*",
    "@dsmith-dev/extractor-styled": "workspace:*",
    "@dsmith-dev/extractor-tailwind": "workspace:*",
    "@dsmith-dev/init": "workspace:*",
    "@types/picomatch": "^4.0.3",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
