{
  "name": "dsmith",
  "version": "0.0.0",
  "description": "Design-system lifecycle CLI: detect your styling setup and audit hardcoded style values",
  "keywords": ["design-system", "design-tokens", "cli", "audit", "dsmith"],
  "license": "MIT",
  "author": "Dahee Hwang <dahee@project-hh.com>",
  "homepage": "https://github.com/project-hh-org/dsmith#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/project-hh-org/dsmith.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dsmith": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@dsmith-dev/agent-skill": "workspace:*",
    "@dsmith-dev/core": "workspace:*",
    "@dsmith-dev/detect": "workspace:*",
    "@dsmith-dev/extractor-api": "workspace:*",
    "@dsmith-dev/extractor-css": "workspace:*",
    "@dsmith-dev/extractor-emotion": "workspace:*",
    "@dsmith-dev/extractor-inline-style": "workspace:*",
    "@dsmith-dev/extractor-mui-sx": "workspace:*",
    "@dsmith-dev/extractor-styled": "workspace:*",
    "@dsmith-dev/extractor-tailwind": "workspace:*",
    "@dsmith-dev/mcp-server": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
