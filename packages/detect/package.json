{
  "name": "@dsmith/detect",
  "version": "0.0.0",
  "description": "dsmith 레포 환경 감지(스타일링·DS·프레임워크·Storybook·lint)와 시작 상태 판정",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
