{
  "name": "@dsmith-dev/mcp-server",
  "version": "0.2.0",
  "description": "dsmith MCP server: design-system tools for AI agents",
  "keywords": ["design-system", "dsmith", "mcp", "model-context-protocol", "ai-agent"],
  "license": "MIT",
  "author": "Dahee Hwang <dahee@project-hh.com>",
  "homepage": "https://github.com/project-hh-org/dsmith#readme",
  "repository": {
    "type": "git",
