{
  "name": "@dsmith-dev/core",
  "version": "0.1.0",
  "description": "Shared model, color and length normalization, parsers and indexer for dsmith",
  "keywords": ["design-system", "design-tokens", "dsmith", "css", "parser"],
  "license": "MIT",
  "author": "Dahee Hwang <dahee@project-hh.com>",
  "homepage": "https://github.com/project-hh-org/dsmith#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/project-hh-org/dsmith.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@babel/parser": "^7.29.12",
    "@babel/traverse": "^7.29.12",
    "@babel/types": "^7.29.11",
    "@dsmith-dev/extractor-api": "workspace:*",
    "culori": "^4.0.1",
    "fast-glob": "^3.3.3",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@dsmith-dev/extractor-inline-style": "workspace:*",
    "@types/babel__traverse": "^7.28.0",
    "@types/culori": "^2.1.1",
    "@types/picomatch": "^4.0.3",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
