{
  "name": "@dsmith-dev/extractor-css",
  "version": "0.2.0",
  "description": "dsmith extractor for .css and .scss files",
  "keywords": ["design-system", "dsmith", "extractor", "css", "scss"],
  "license": "MIT",
  "author": "Dahee Hwang <dahee@project-hh.com>",
  "homepage": "https://github.com/project-hh-org/dsmith#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/project-hh-org/dsmith.git",
    "directory": "packages/extractor-css"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@dsmith-dev/core": "workspace:*",
    "@dsmith-dev/extractor-api": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
