{
  "name": "dsmith-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "디자인시스템 라이프사이클 CLI — detect · audit · init · migrate · guard · ai · usage (임시 이름)",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r --filter './packages/*' test",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "lint": "pnpm -r --filter './packages/*' lint",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && pnpm publish -r --access public --no-git-checks && changeset tag"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
